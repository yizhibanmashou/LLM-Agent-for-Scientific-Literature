    {
      "type": "proposition",
      "content": "Putting these together yields Bayes' theorem $$ \\mathrm{Pr}(\\theta\\mid x)=\\frac{\\mathrm{Pr}(x\\mid\\theta)\\mathrm{Pr}(\\theta)}{\\mathrm{Pr}(x)} $$",
      "source_page": 1190,
      "source_pages": [
        1190
      ],
      "source_block_ids": [
        "Evolution_appendix2:p002:b10",
        "Evolution_appendix2:p002:b11"
      ],
      "source_bboxes": [
        [
          288.0,
