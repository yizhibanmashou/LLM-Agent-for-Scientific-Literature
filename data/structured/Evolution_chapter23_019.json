          904.0,
          733.0
        ],
        [
          287.0,
          1310.0,
          1059.0,
          1358.0
        ]
      ],
      "provenance_score": 1.0,
      "coverage_repair": "authoritative_chapter_pdf_source_block",
      "content_sha256": "dfcde7b63328c5830584ce47aca68617f2fbc42b92e98e7609733787d03bef43"
    },
    {
      "type": "derivation",
      "content": "$$ \\begin{aligned}\\sigma_G(T,\\tau,t)&=(1+f_t)\\sigma_A^2+\\left(\\frac{(1+f_t)(1-f_T)(1-f_\\tau)}{1-f_t}\\right)\\sigma_D^2+(1+f_t)^2\\sigma_{AA}^2+\\cdots\\\\ &=\\left(2-\\frac{1}{2^t}\\right)\\left(\\sigma_A^2+\\frac{\\sigma_D^2}{2^{T+\\tau-t}}+\\left(2-\\frac{1}{2^t}\\right)\\sigma_{AA}^2+\\cdots\\right)\\end{aligned} $$",
      "source_page": 832,
      "source_pages": [
        832
      ],
      "source_block_ids": [
        "Evolution_chapter23:p026:b12"
      ],
      "source_bboxes": [
        [
          335.0,
