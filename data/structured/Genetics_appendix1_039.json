        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "90952c496f40138d9c5e7771cbe00cc86476eba9a9f0c4043fc5154f5b62fd0b"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula231]]",
      "source_page": 872,
      "printed_page": 852,
      "source_block_ids": [
        "Genetics_appendix1:p054:b12",
        "Genetics_appendix1:p054:b13"
      ],
      "bbox": [
