          881.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "129b8a09913452205f970144194fe98a7a0828e3d7ae01ef643a44563c1ca5b9"
    },
    {
      "type": "discussion",
      "content": "Suppose we wish to compare the relative fit of two models that assume the same covariance structure (i.e., the same V), but have different vectors of fixed effects, a vector $ \\beta_f $ for the full model vs. a vector $ \\beta_r $ for the reduced model that assumes fewer factors. The resulting likelihood-ratio test statistic is",
      "source_page": 872,
      "printed_page": 852,
      "source_block_ids": [
        "Genetics_appendix1:p054:b11"
      ],
      "bbox": [
        144.0,
        882.0,
        1103.0,
        1011.0
      ],
      "source_pages": [
        872
      ],
      "source_bboxes": [
