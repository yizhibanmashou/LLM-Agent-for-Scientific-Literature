      "content_sha256": "bf25e44048a771469f89e925c2807aa35953b2583513c93898e26c36aa19229b"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter10_formula033]]",
      "source_page": 291,
      "printed_page": 271,
