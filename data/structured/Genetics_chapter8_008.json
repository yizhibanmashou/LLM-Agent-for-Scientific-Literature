      "content": "[[FORMULA:Genetics_chapter8_formula021]]",
      "source_page": 200,
      "printed_page": 180,
      "source_block_ids": [
        "p200:b11"
      ],
      "bbox": [
        267.0,
        998.0,
        970.0,
        1132.0
      ]
    },
    {
      "type": "discussion",
      "content": "and N as a row vector of b column vectors,",
      "source_page": 200,
