  "blocks": [
    {
      "type": "discussion",
      "content": "At equilibrium, a probability density function does not change over time, namely, $$ \\frac{\\partial\\varphi(x,t,p)}{\\partial t}=0 $$",
      "source_page": 1175,
      "source_pages": [
        1175
      ],
      "source_block_ids": [
        "Evolution_appendix1:p005:b25",
        "Evolution_appendix1:p005:b26",
        "Evolution_appendix1:p005:b27"
      ],
      "source_bboxes": [
        [
