  "blocks": [
    {
      "type": "discussion",
      "content": "There are a variety of methods for determining whether a character is normally distributed — see Chapter 6 of Sokal and Rohlf (1995) for an introduction, and",
      "source_page": 309,
      "printed_page": 289,
      "source_block_ids": [
        "Genetics_chapter11:p003:b13",
        "Genetics_chapter11:p003:b14"
      ],
      "bbox": [
