          542.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "270c96a15c8e66b83a1b30adc6a590816ba9134be3554fdddc1fc046c31d90aa"
    },
    {
      "type": "discussion",
      "content": "Consider a symmetric nonsingular matrix V and define $ V^{1/2} $ as the matrix satisfying",
      "source_page": 853,
      "printed_page": 833,
      "source_block_ids": [
        "Genetics_appendix1:p035:b5"
      ],
      "bbox": [
