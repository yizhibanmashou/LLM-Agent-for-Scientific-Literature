        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "23cad274778cc74a9f6595c2c86d1823533888b49f14ff6831bca13d56f160c7"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula134]]",
      "source_page": 853,
      "printed_page": 833,
      "source_block_ids": [
        "Genetics_appendix1:p035:b18",
        "Genetics_appendix1:p035:b19"
      ],
      "bbox": [
