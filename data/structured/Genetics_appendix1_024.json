    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula130]]",
      "source_page": 853,
      "printed_page": 833,
      "source_block_ids": [
        "Genetics_appendix1:p035:b6",
        "Genetics_appendix1:p035:b7"
      ],
      "bbox": [
        443.0,
