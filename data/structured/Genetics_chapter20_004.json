      "provenance_score": 1.0,
      "content_sha256": "20ada9d90fa150201cebeb4a7e766ede697fe460818bd5eba96664c01e6ff121"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter20_formula015]]",
      "source_page": 617,
      "printed_page": 597,
      "source_block_ids": [
