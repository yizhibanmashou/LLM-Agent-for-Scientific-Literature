      ],
      "provenance_score": 1.0,
      "content_sha256": "0d27228cd1cfc26ab13112edeac777713748cc26944610cbe66b597bce2d2e85"
    },
    {
      "type": "discussion",
      "content": "Under the Cockerham-Weir model, the phenotype of the kth offspring of the cross between i as father and j as mother is represented as",
      "source_page": 617,
      "printed_page": 597,
      "source_block_ids": [
        "Genetics_chapter20:p009:b5"
      ],
      "bbox": [
