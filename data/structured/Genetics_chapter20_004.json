  "blocks": [
    {
      "type": "discussion",
      "content": "Cockerham and Weir (1977b) generalized Design II to incorporate reciprocal crosses, which are possible with hermaphrodites and with inbred lines. The advantage of this modification over the Comstock-Robinson approach is that an explicit partitioning of nuclear and extranuclear effects is possible.",
      "source_page": 617,
      "printed_page": 597,
      "source_block_ids": [
        "Genetics_chapter20:p009:b3",
        "Genetics_chapter20:p009:b4"
      ],
      "bbox": [
        72.0,
        284.0,
        1033.0,
        440.0
      ],
      "source_pages": [
        617
      ],
      "source_bboxes": [
