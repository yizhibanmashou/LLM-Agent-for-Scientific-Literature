          1446.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "4dcb9a1d0ee50393bf93a3d88a657f6abc112e96dc7e3feebf9cbfcc1a9e7d7f"
    },
    {
      "type": "discussion",
      "content": "1. If $\\mathbf{x} \\sim \\text{MVN}$, then the distribution of any subset of the variables in $\\mathbf{x}$ is also MVN. For example, each $x_{i}$ is normally distributed and each pair $(x_{i}, x_{j})$ is bivariate normally distributed.",
      "source_page": 211,
      "printed_page": 191,
      "source_block_ids": [
        "Genetics_chapter8:p019:b17"
      ],
      "bbox": [
        46.0,
        1435.0,
        957.0,
        1551.0
      ],
      "source_pages": [
        211
      ],
      "source_bboxes": [
        [
          46.0,
