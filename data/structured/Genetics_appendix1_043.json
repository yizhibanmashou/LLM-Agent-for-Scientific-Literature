      ],
      "provenance_score": 1.0,
      "content_sha256": "d09bb88eb0b512665bad025bc7098b6836161a4fc6bb46a6b5a53e34c6b9fba5"
    },
    {
      "type": "discussion",
      "content": "(1) Initial step. Choose initial starting values for the MLEs of the variance $ \\widehat{\\sigma}^{2}(0) $ and the vectors of mixture proportions and means,",
      "source_page": 876,
      "printed_page": 856,
      "source_block_ids": [
        "Genetics_appendix1:p058:b13"
      ],
