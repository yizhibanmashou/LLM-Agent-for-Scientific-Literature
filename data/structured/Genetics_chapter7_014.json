        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "34326ce2d3c9412d76a89cfd0d94f96d503c1ce7e0c226c97d461cd12f6d8d70"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter7_formula047]]",
      "source_page": 191,
      "printed_page": 171,
      "source_block_ids": [
        "Genetics_chapter7:p045:b10",
        "Genetics_chapter7:p045:b9"
      ],
      "bbox": [
