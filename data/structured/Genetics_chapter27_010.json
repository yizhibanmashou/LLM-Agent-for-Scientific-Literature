          1138.0,
          1368.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "c36e5130c1441b233674c8d535cc09c8311ffe13bc567cbf4a5bd320ea725f43"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter27_formula072]]",
      "source_page": 806,
      "printed_page": 786,
      "source_block_ids": [
        "Genetics_chapter27:p016:b8",
        "Genetics_chapter27:p016:b9"
      ],
      "bbox": [
        433.0,
        1361.0,
