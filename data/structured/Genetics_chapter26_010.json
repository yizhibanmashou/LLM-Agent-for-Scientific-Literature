      "content_sha256": "0a223debd3a7f4cdcac599b76ea0039a530ef4abeb6257147f4869778db5d3bb"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter26_formula050]]",
      "source_page": 771,
      "printed_page": 751,
      "source_block_ids": [
        "Genetics_chapter26:p015:b3",
        "Genetics_chapter26:p015:b4"
      ],
      "bbox": [
