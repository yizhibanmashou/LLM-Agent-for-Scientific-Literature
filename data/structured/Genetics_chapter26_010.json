      "content_sha256": "cc7fab36bbbeae7f9505fd81718b9f27612cd4acf1ecd8fa113d0f32e7aa2daf"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter26_formula049]]",
      "source_page": 770,
      "printed_page": 750,
      "source_block_ids": [
        "Genetics_chapter26:p014:b15",
        "Genetics_chapter26:p014:b16"
      ],
      "bbox": [
