      "content_sha256": "1157e6934a0baf4a48ddebe9f39f015f2bf654130f67e8faada687748d27a867"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter18_formula066]]",
      "source_page": 590,
      "printed_page": 570,
      "source_block_ids": [
