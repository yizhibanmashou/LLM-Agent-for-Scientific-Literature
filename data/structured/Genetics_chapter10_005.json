          429.0,
          1089.0,
          753.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "ded658b4b8321d1ea26e858e8b9fec787a9414af93d68112d3a7b0fa1610a56f"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter10_formula010]]",
      "source_page": 276,
