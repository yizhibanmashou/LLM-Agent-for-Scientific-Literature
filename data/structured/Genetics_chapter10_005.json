  "blocks": [
    {
      "type": "discussion",
      "content": "A common short-term test of inbreeding depression involves the comparison of the mean phenotypes of offspring from random matings with those from a specific class of consanguineous mating. In any such analysis, both types of individuals should be raised simultaneously in a random design to eliminate the possibility that the differences in means are a product of the environment. Ideally, the offspring of both types of matings should be derived from several mothers to minimize the importance of maternal effects, and all mothers certainly should be derived from the same base population.",
      "source_page": 276,
      "printed_page": 256,
      "source_block_ids": [
        "Genetics_chapter10:p010:b2",
        "Genetics_chapter10:p010:b3"
      ],
      "bbox": [
        126.0,
        173.0,
        1087.0,
        431.0
      ],
      "source_pages": [
        276
      ],
      "source_bboxes": [
