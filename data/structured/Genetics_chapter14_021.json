    },
    {
      "type": "discussion",
      "content": "<table><tr><td></td><td>Transmitted</td><td>Not Transmitted</td></tr><tr><td>Affected Offspring</td><td>$ T_{A} $</td><td>$ NT_{A} $</td></tr><tr><td>Unaffected Offspring</td><td>$ T_{U} $</td><td>$ NT_{U} $</td></tr></table>",
