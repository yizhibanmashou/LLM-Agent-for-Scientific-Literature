          648.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "a7e17bd27c1504a7e123f5e94137940d79e47f0c0ab6e533bea73a1464bf708e"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter14_formula035]]",
      "source_page": 435,
      "printed_page": 415,
      "source_block_ids": [
        "Genetics_chapter14:p043:b4",
