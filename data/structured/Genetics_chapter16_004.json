      "provenance_score": 1.0,
      "content_sha256": "4a26385eabc7c331805844f16686938442a995ee2f444279a28b3afca890cd61"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter16_formula010]]",
      "source_page": 511,
      "printed_page": 491,
      "source_block_ids": [
