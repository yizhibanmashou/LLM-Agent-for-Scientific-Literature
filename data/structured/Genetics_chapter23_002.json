    {
      "type": "discussion",
      "content": "We first consider the four sources of environmental covariance given in the second line of this formula:",
      "source_page": 701,
      "printed_page": 681,
      "source_block_ids": [
        "Genetics_chapter23:p003:b6"
      ],
      "bbox": [
        64.0,
        509.0,
