    {
      "type": "discussion",
      "content": "where the ith row of the design matrix $ \\mathbf{X}_{c_1} $ is $ (1, x(M_i, c_1), y(M_i, c_1)) $.",
      "source_page": 468,
      "printed_page": 448,
