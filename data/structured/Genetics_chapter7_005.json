      "content_sha256": "f5c909e0148a5da20a5c8bbd4d4964747c60801d2c91afb0c2a44fbc726144cb"
    },
    {
      "type": "discussion",
      "content": "Now consider the case of paternal half sibs, in which case the fathers are the same individual, but the mothers are different. Now,",
      "source_page": 157,
      "printed_page": 137,
