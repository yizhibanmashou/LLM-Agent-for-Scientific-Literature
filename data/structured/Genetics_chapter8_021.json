    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter8_formula114]]",
      "source_page": 216,
      "printed_page": 196,
      "source_block_ids": [
        "Genetics_chapter8:p024:b9"
      ],
      "bbox": [
