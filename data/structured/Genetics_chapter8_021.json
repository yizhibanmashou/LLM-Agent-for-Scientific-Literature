        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "c114e57a20f0437ba4b7915e0e058b1664e23f5c84bb3faa0b45e07c53b82c0d"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter8_formula117]]",
      "source_page": 216,
      "printed_page": 196,
      "source_block_ids": [
        "Genetics_chapter8:p024:b16",
        "Genetics_chapter8:p024:b17"
      ],
      "bbox": [
        529.0,
        1493.0,
        759.0,
        1540.0
      ],
      "source_pages": [
