      "content_sha256": "dbf0884ad04c82d74edcf6f3d8e1399177d3ad8c020571b2a15b3b4d4e637b53"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter8_formula116]]",
      "source_page": 216,
      "printed_page": 196,
      "source_block_ids": [
        "Genetics_chapter8:p024:b13",
        "Genetics_chapter8:p024:b14"
      ],
      "bbox": [
