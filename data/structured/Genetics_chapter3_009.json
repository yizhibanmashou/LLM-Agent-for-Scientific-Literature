        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "dfb2d52747ba88a0a004fcaff9a6fc9ab53b2b080ddc3e6ee4cd5df971082109"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter3_formula033]]",
      "source_page": 60,
      "printed_page": 40,
      "source_block_ids": [
        "Genetics_chapter3:p010:b3",
        "Genetics_chapter3:p010:b4"
      ],
      "bbox": [
