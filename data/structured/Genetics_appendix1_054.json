      "source_block_ids": [
        "p890:b11"
      ],
      "bbox": [
        524.0,
        831.0,
        727.0,
        918.0
      ]
    },
    {
      "type": "discussion",
      "content": "and for $ \\overline{x}=n^{-1}\\sum_{i=1}^{n}x_{i}, $",
      "source_page": 890,
      "printed_page": 870,
      "source_block_ids": [
        "p890:b13"
      ],
      "bbox": [
        149.0,
        944.0,
