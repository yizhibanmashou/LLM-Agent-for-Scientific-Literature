      "content_sha256": "ca4d85317d4447db9a884017b730ef49803e8b84f7511046520cae57929e6ce6"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter23_formula028]]",
      "source_page": 719,
