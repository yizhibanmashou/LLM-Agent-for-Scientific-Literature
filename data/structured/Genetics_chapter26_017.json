    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter26_formula111]]",
      "source_page": 785,
      "printed_page": 765,
      "source_block_ids": [
        "Genetics_chapter26:p029:b6",
        "Genetics_chapter26:p029:b7"
      ],
