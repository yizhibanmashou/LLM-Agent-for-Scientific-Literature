        322.0
      ]
    },
    {
      "type": "discussion",
      "content": "Substituting this into Equation A5.26a and applying Equation A5.15c gives",
      "source_page": 896,
      "printed_page": 876,
      "source_block_ids": [
        "p896:b5"
      ],
      "bbox": [
        139.0,
