        1141.0
      ]
    },
    {
      "type": "discussion",
      "content": "where n is the number of pairs of observations, and",
      "source_page": 53,
      "printed_page": 33,
      "source_block_ids": [
        "p53:b13"
      ],
      "bbox": [
