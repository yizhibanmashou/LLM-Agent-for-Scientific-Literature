        741.0
      ]
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula115]]",
      "source_page": 850,
      "printed_page": 830,
      "source_block_ids": [
        "p850:b10"
      ],
      "bbox": [
        526.0,
        769.0,
        715.0,
        806.0
      ]
    },
    {
      "type": "discussion",
      "content": "To see this, note that Equation A3.4 gives the general solution as",
      "source_page": 850,
      "printed_page": 830,
      "source_block_ids": [
        "p850:b12"
      ],
      "bbox": [
        143.0,
