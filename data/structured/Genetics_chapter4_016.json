      "content_sha256": "3e85a1cdcde0d20fc3c5a1dd995f70a9c764b1fd861e52d50bf39a4677d2f245"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter4_formula052]]",
      "source_page": 93,
      "printed_page": 73,
      "source_block_ids": [
