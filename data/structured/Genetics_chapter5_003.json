      "content_sha256": "35944036f0fbdcb8b1bed4a94db6edcbe65d473fa65dee15553d3f7ef2551121"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter5_formula008]]",
