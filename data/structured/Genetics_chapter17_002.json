      "content_sha256": "38f12e701b2538be8228714b6b314d38084f38bf75868d4b404a397462579312"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter17_formula003]]",
      "source_page": 552,
      "printed_page": 532,
      "source_block_ids": [
        "Genetics_chapter17:p002:b12"
      ],
      "bbox": [
        403.0,
