      "content_sha256": "7070f32c1f67a561b64dde09ecd3eb4337e90eb98cd8425557c2a7511f7529a6"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter17_formula004]]",
      "source_page": 552,
      "printed_page": 532,
      "source_block_ids": [
        "Genetics_chapter17:p002:b14",
        "Genetics_chapter17:p002:b15"
      ],
      "bbox": [
