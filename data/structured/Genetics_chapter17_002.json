      "content_sha256": "d90b5ad8b8af100fb70beac7289e2919fe6fa575a4d4b223da6e5b269836e67e"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter17_formula002]]",
