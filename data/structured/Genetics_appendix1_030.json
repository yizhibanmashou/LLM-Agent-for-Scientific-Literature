      "provenance_score": 1.0,
      "content_sha256": "51ad0a79ac08638fa7079c594aa5de9e5d9075ebf61eb9abe50ddf88ed9d3004"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula176]]",
      "source_page": 860,
      "printed_page": 840,
      "source_block_ids": [
