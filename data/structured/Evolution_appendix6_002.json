    },
    {
      "type": "derivation",
      "content": "$$ f(\\widehat{\\mathbf{x}}+\\mathbf{d})-f(\\widehat{\\mathbf{x}})\\simeq\\frac{1}{2}\\sum {i=1}^{n}\\lambda {i}y {i}^{2} $$",
