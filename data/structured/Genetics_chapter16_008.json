      "content_sha256": "619d6d16612ab8d44a454e7c4868724860db53af82ddf34029546257971b3a2a"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter16_formula031]]",
      "source_page": 519,
      "printed_page": 499,
      "source_block_ids": [
        "Genetics_chapter16:p015:b3"
      ],
      "bbox": [
        416.0,
