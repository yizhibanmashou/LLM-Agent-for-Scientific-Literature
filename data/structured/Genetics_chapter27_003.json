          995.0,
          981.0
        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "870f6439d5889c073cb88480431c7facdf909a022c5656521d65801cb1588839"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter27_formula014]]",
      "source_page": 795,
      "printed_page": 775,
      "source_block_ids": [
