    },
    {
      "type": "discussion",
      "content": "This sequence suggests an iterative approach for estimating the variance,",
      "source_page": 795,
      "printed_page": 775,
      "source_block_ids": [
        "Genetics_chapter27:p005:b14"
      ],
      "bbox": [
        31.0,
        1066.0,
