        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "bf068dad06f51e60c255b4f6bacffed6197a25a30c53a726ed80656cc505d618"
    },
    {
      "type": "discussion",
      "content": "However, just as this changes the estimate of the variance, it also changes the estimate of $ (\\overline{y} - \\mu)^2 $. Hence, a third estimate of $ \\sigma^2 $ would be",
      "source_page": 795,
      "printed_page": 775,
      "source_block_ids": [
        "Genetics_chapter27:p005:b11"
      ],
      "bbox": [
        35.0,
        885.0,
        995.0,
        981.0
      ],
      "source_pages": [
        795
      ],
      "source_bboxes": [
        [
          35.0,
