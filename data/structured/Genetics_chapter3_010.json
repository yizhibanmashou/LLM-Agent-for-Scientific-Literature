        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "02ff6b4127aa615d9e7a4046adbd2b7f645b8ddf21913a43477b62e93a34d722"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter3_formula046]]",
      "source_page": 62,
      "printed_page": 42,
      "source_block_ids": [
        "Genetics_chapter3:p012:b18",
        "Genetics_chapter3:p012:b19"
      ],
