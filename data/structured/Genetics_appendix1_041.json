      "provenance_score": 1.0,
      "content_sha256": "7232867eb8bd25ddfb2993d2170e86e204391e60217716cfb5a02e93fc85200d"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula239]]",
      "source_page": 874,
      "printed_page": 854,
      "source_block_ids": [
        "Genetics_appendix1:p056:b15",
        "Genetics_appendix1:p056:b16"
      ],
      "bbox": [
