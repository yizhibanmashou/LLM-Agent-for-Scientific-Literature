        ]
      ],
      "provenance_score": 1.0,
      "content_sha256": "7c3367d956d58598282ce9bd5e8d2afbe15f9dbee7f753a5e97ff204eb0535bc"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_appendix1_formula237]]",
      "source_page": 874,
      "printed_page": 854,
      "source_block_ids": [
