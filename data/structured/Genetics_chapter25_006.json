      "content_sha256": "c22b0d7b011812dfd51c7d47899788ca7097b85a28791e727937eea9e6c1192c"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter25_formula015]]",
      "source_page": 754,
      "printed_page": 734,
      "source_block_ids": [
        "Genetics_chapter25:p016:b6",
        "Genetics_chapter25:p016:b7"
      ],
