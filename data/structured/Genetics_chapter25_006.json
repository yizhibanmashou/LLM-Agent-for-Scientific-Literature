      "content_sha256": "72cf66e6539f008efdf184b53d79d31067dbe21fca27f5e51259d1d86c28c9a2"
    },
    {
      "type": "discussion",
      "content": "[[FORMULA:Genetics_chapter25_formula016]]",
      "source_page": 754,
      "printed_page": 734,
      "source_block_ids": [
        "Genetics_chapter25:p016:b10",
        "Genetics_chapter25:p016:b9"
      ],
