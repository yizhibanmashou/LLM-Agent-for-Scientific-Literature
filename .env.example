# Copy this file to .env in the repository root.
# Never commit real API keys or tokens.

# paper2latex Paddle service
PAPER2LATEX_INPUT_DIR=data/背景资料
PAPER2LATEX_OUTPUT_DIR=data/paddle_output
PAPER2LATEX_PADDLE_PIPELINE=PaddleOCR-VL
PAPER2LATEX_PADDLE_SOURCE=aistudio
PAPER2LATEX_PADDLE_API_URL=
PAPER2LATEX_PADDLE_API_TOKEN=
PADDLEOCR_MCP_TIMEOUT=900

# Optional LLM verifier for knowledge_engineering
KE_LLM_PROVIDER=local
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
KE_LLM_CACHE_DIR=tmp/llm_cache
