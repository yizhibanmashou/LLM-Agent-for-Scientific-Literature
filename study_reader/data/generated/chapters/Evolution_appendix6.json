    {
      "id": "Evolution_appendix6_005",
      "title": "Appendix: Introduction / THE HESSIAN MATRIX, LOCAL MAXIMA/MINIMA, AND MULTIDIMENSIONAL TAYLOR SERIES",
      "nav_label": "MINIMA, AND MULTIDIMENSIONAL TAYLOR SERIES",
