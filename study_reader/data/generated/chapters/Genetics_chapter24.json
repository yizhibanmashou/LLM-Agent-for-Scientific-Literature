    {
      "kind": "formula",
      "id": "24.5a",
      "anchor": "formula-24.5a",
      "label": "Formula (24.5a)",
      "section_id": "Genetics_chapter24_005",
      "latex": "\\begin{aligned}\\sigma^{2}(G_{M})=&\\sigma^{2}(A_{M})+\\sigma^{2}(D_{M})+\\sigma^{2}(A_{M}A_{M})+\\sigma^{2}(A_{M}D_{M})+\\cdots\\\\&+\\sigma^{2}(A_{M}^{\\prime})+\\sigma^{2}(A_{M}^{\\prime}A_{M}^{\\prime})+\\cdots\\\\&+\\sigma^{2}(A_{M}A_{M}^{\\prime})+\\sigma^{2}(A_{M}^{\\prime}D_{M})+\\cdots\\end{aligned}",
      "latex_render": "\\begin{aligned}\\sigma^{2}(G_{M})=&\\sigma^{2}(A_{M})+\\sigma^{2}(D_{M})+\\sigma^{2}(A_{M}A_{M})+\\sigma^{2}(A_{M}D_{M})+\\cdots\\\\&+\\sigma^{2}(A_{M}^{\\prime})+\\sigma^{2}(A_{M}^{\\prime}A_{M}^{\\prime})+\\cdots\\\\&+\\sigma^{2}(A_{M}A_{M}^{\\prime})+\\sigma^{2}(A_{M}^{\\prime}D_{M})+\\cdots\\end{aligned}",
      "origin": "formula-library",
      "source_label": "Formula 1.u011"
    },
    {
      "kind": "formula",
      "id": "24.5b",
      "anchor": "formula-24.5b",
      "label": "Formula (24.5b)",
      "section_id": "Genetics_chapter24_005",
      "latex": "\\begin{align*}\\sigma(G_{Mx},G_{My})&=2\\Theta_{xy}\\sigma^{2}(A_{M})+\\Delta_{xy}\\sigma^{2}(D_{M})+\\phi_{xy}\\sigma^{2}(A_{M}^{\\prime})\\\\&\\quad+\\sum(2\\Theta_{xy})^{\\alpha}\\Delta_{xy}^{\\beta}\\phi_{xy}^{\\lambda}\\sigma^{2}[A_{M}^{\\alpha}D_{M}^{\\beta}(A_{M}^{\\prime})^{\\lambda}]\\end{align*}",
      "latex_render": "\\begin{aligned}\\sigma(G_{Mx},G_{My})&=2\\Theta_{xy}\\sigma^{2}(A_{M})+\\Delta_{xy}\\sigma^{2}(D_{M})+\\phi_{xy}\\sigma^{2}(A_{M}^{\\prime})\\\\&\\quad+\\sum(2\\Theta_{xy})^{\\alpha}\\Delta_{xy}^{\\beta}\\phi_{xy}^{\\lambda}\\sigma^{2}[A_{M}^{\\alpha}D_{M}^{\\beta}(A_{M}^{\\prime})^{\\lambda}]\\end{aligned}",
      "origin": "formula-library",
      "source_label": "Formula 1.u012"
    },
    {
      "kind": "formula",
      "id": "24.6a",
      "anchor": "formula-24.6a",
      "label": "Formula (24.6a)",
      "section_id": "Genetics_chapter24_005",
      "latex": "\\begin{aligned}\\sigma(G_{F})=&\\sigma^{2}(A_{F})+\\sigma^{2}(D_{F})+\\sigma^{2}(A_{F}A_{F})+\\sigma^{2}(A_{F}D_{F})+\\cdots\\\\\\sigma^{2}&(A_{F}^{\\prime})+\\sigma^{2}(D_{F}^{\\prime})+\\sigma^{2}(A_{F}^{\\prime}A_{F}^{\\prime})+\\sigma^{2}(A_{F}^{\\prime}D_{F}^{\\prime})+\\cdots\\\\\\sigma^{2}&(A_{F}A_{F}^{\\prime})+\\sigma^{2}(A_{F}^{\\prime}D_{F})+\\sigma^{2}(A_{F}D_{F}^{\\prime})+\\sigma^{2}(D_{F}D_{F}^{\\prime})+\\cdots\\end{aligned}",
      "latex_render": "\\begin{aligned}\\sigma(G_{F})=&\\sigma^{2}(A_{F})+\\sigma^{2}(D_{F})+\\sigma^{2}(A_{F}A_{F})+\\sigma^{2}(A_{F}D_{F})+\\cdots\\\\\\sigma^{2}&(A_{F}^{\\prime})+\\sigma^{2}(D_{F}^{\\prime})+\\sigma^{2}(A_{F}^{\\prime}A_{F}^{\\prime})+\\sigma^{2}(A_{F}^{\\prime}D_{F}^{\\prime})+\\cdots\\\\\\sigma^{2}&(A_{F}A_{F}^{\\prime})+\\sigma^{2}(A_{F}^{\\prime}D_{F})+\\sigma^{2}(A_{F}D_{F}^{\\prime})+\\sigma^{2}(D_{F}D_{F}^{\\prime})+\\cdots\\end{aligned}",
      "origin": "formula-library",
      "source_label": "Formula 1.u013"
    },
    {
      "kind": "formula",
      "id": "24.6b",
      "anchor": "formula-24.6b",
      "label": "Formula (24.6b)",
      "section_id": "Genetics_chapter24_005",
      "latex": "\\begin{align*}\\sigma(G_{Fx},G_{Fy})&=2\\Theta_{xy}\\sigma^{2}(A_{F})+\\Delta_{xy}\\sigma^{2}(D_{F})+2\\Theta_{xy}^{\\prime}\\sigma^{2}(A_{F}^{\\prime})+\\Delta_{xy}^{\\prime}\\sigma^{2}(D_{F}^{\\prime})\\\\&\\quad+\\sum(2\\Theta_{xy})^{\\alpha}\\Delta_{xy}^{\\beta}(2\\Theta_{xy}^{\\prime})^{\\lambda}(\\Delta_{xy}^{\\prime})^{\\delta}\\sigma^{2}[A_{F}^{\\alpha}D_{F}^{\\beta}(A_{F}^{\\prime})^{\\lambda}(D_{F}^{\\prime})^{\\delta}]\\quad\\end{align*}",
      "latex_render": "\\begin{aligned}\\sigma(G_{Fx},G_{Fy})&=2\\Theta_{xy}\\sigma^{2}(A_{F})+\\Delta_{xy}\\sigma^{2}(D_{F})+2\\Theta_{xy}^{\\prime}\\sigma^{2}(A_{F}^{\\prime})+\\Delta_{xy}^{\\prime}\\sigma^{2}(D_{F}^{\\prime})\\\\&\\quad+\\sum(2\\Theta_{xy})^{\\alpha}\\Delta_{xy}^{\\beta}(2\\Theta_{xy}^{\\prime})^{\\lambda}(\\Delta_{xy}^{\\prime})^{\\delta}\\sigma^{2}[A_{F}^{\\alpha}D_{F}^{\\beta}(A_{F}^{\\prime})^{\\lambda}(D_{F}^{\\prime})^{\\delta}]\\quad\\end{aligned}",
      "origin": "formula-library",
      "source_label": "Formula 1.u014"
    },
    {
      "kind": "formula",
      "id": "24.7",
      "anchor": "formula-24.7",
      "label": "Formula (24.7)",
      "section_id": "Genetics_chapter24_005",
      "latex": "\\begin{aligned}\\sigma(G_{Fx},G_{My})&=2\\Theta_{xy}\\sigma(A_{F},A_{M})+\\Delta_{xy}\\sigma(D_{F},D_{M})+2\\gamma_{xy}\\sigma(A_{F}^{\\prime},A_{M}^{\\prime})\\\\&\\quad+\\sum(2\\Theta_{xy})^{\\alpha}\\Delta_{xy}^{\\beta}(2\\gamma_{xy})^{\\lambda}\\sigma[A_{FM}^{\\alpha}D_{FM}^{\\beta}(A_{FM}^{\\prime})^{\\lambda}]\\end{aligned}",
      "latex_render": "\\begin{aligned}\\sigma(G_{Fx},G_{My})&=2\\Theta_{xy}\\sigma(A_{F},A_{M})+\\Delta_{xy}\\sigma(D_{F},D_{M})+2\\gamma_{xy}\\sigma(A_{F}^{\\prime},A_{M}^{\\prime})\\\\&\\quad+\\sum(2\\Theta_{xy})^{\\alpha}\\Delta_{xy}^{\\beta}(2\\gamma_{xy})^{\\lambda}\\sigma[A_{FM}^{\\alpha}D_{FM}^{\\beta}(A_{FM}^{\\prime})^{\\lambda}]\\end{aligned}",
      "origin": "formula-library",
      "source_label": "Formula 1.u015"
    },
